# ── Dashboard Security ────────────────────────────────────────────────────────
# Username and password for the web dashboard (HTTP Basic Auth)
# CHANGE THESE before deploying! Never use the defaults in production.
DASHBOARD_USER=admin
DASHBOARD_PASS=your_strong_password_here

# ── Server ────────────────────────────────────────────────────────────────────
# Port the dashboard listens on (default: 3000)
PORT=3000

# Optional Groq fallback for messages the regex parser cannot safely extract
# Keep the API key private; leave blank to disable AI fallback.
GROQ_API_KEY=
# Strict JSON schema output is supported by this Groq model.
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_MS=8000

# ── Notes ─────────────────────────────────────────────────────────────────────
# 1. Copy this file to .env  →  cp .env.example .env
# 2. Edit .env with your real values
# 3. NEVER commit .env to Git (it is in .gitignore)
